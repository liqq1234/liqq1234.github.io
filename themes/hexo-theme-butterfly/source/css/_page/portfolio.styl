.portfolio-showcase
  width: 100%
  max-width: 1240px
  margin: 0 auto
  padding: 20px 0 60px

.portfolio-item
  display: flex
  align-items: center
  justify-content: space-between
  gap: 50px
  padding: 60px 40px
  margin-bottom: 40px
  border-radius: 24px
  background: var(--card-bg)
  box-shadow: var(--card-box-shadow)
  transition: all 0.3s ease

  &:hover
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12)

.portfolio-item.portfolio-reverse
  flex-direction: row-reverse

.portfolio-content
  flex: 1.2
  min-width: 0

.portfolio-tag
  display: inline-block
  font-size: 13px
  font-weight: 600
  padding: 4px 14px
  border-radius: 20px
  background: rgba(73, 177, 245, 0.12)
  color: $theme-color
  margin-bottom: 14px
  letter-spacing: 0.5px

.portfolio-title
  font-size: 30px
  font-weight: 700
  line-height: 1.35
  color: var(--font-color)
  margin: 0 0 12px 0
  border-bottom: none

.portfolio-subtitle
  font-size: 15px
  font-weight: 600
  color: var(--font-color)
  opacity: 0.7
  margin-bottom: 16px

.portfolio-desc
  font-size: 15px
  line-height: 1.7
  color: var(--font-color)
  opacity: 0.9
  margin-bottom: 18px

.portfolio-highlights
  margin: 0 0 28px 0
  padding-left: 20px
  list-style-type: disc

  li
    font-size: 14.5px
    line-height: 1.8
    color: var(--font-color)
    opacity: 0.88
    margin-bottom: 6px

.portfolio-actions
  margin-top: 20px

.portfolio-btn
  display: inline-block
  padding: 9px 36px
  font-size: 15px
  font-weight: 600
  border-radius: 28px
  border: 1.5px solid var(--font-color)
  color: var(--font-color) !important
  background: transparent
  text-decoration: none
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1)

  &:hover
    background: $theme-color
    border-color: $theme-color
    color: #ffffff !important
    transform: translateY(-2px)
    box-shadow: 0 6px 16px rgba(73, 177, 245, 0.35)

.portfolio-visual
  flex: 1
  display: flex
  justify-content: center
  align-items: center

.portfolio-img-box
  width: 100%
  max-width: 480px
  border-radius: 20px
  overflow: hidden
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.15)
  transition: transform 0.4s ease, box-shadow 0.4s ease

  &:hover
    transform: translateY(-6px) scale(1.01)
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.22)

.portfolio-img
  width: 100%
  height: auto
  display: block

.portfolio-footer-banner
  margin-top: 30px
  padding: 45px 30px
  text-align: center
  border-radius: 24px
  background: var(--card-bg)
  box-shadow: var(--card-box-shadow)

.footer-banner-title
  font-size: 22px
  font-weight: 700
  color: var(--font-color)
  margin-bottom: 8px

.footer-banner-desc
  font-size: 14.5px
  color: var(--font-color)
  opacity: 0.7
  margin-bottom: 22px

.footer-banner-btn
  display: inline-block
  padding: 10px 28px
  font-size: 14.5px
  font-weight: 600
  border-radius: 25px
  background: $theme-color
  color: #ffffff !important
  text-decoration: none
  transition: all 0.3s ease

  &:hover
    transform: translateY(-2px)
    box-shadow: 0 8px 20px rgba(73, 177, 245, 0.35)

@media screen and (max-width: 900px)
  .portfolio-item
    flex-direction: column-reverse !important
    padding: 32px 20px
    gap: 30px

  .portfolio-title
    font-size: 22px

  .portfolio-img-box
    max-width: 100%
