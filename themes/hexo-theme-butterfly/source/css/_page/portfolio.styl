// Reset and expand homepage layout to 100% full bleed width
#body-wrap.page-home,
#body-wrap.type-portfolio,
.portfolio-home
  #content-inner.layout,
  &.layout
    max-width: 100% !important
    width: 100% !important
    padding: 0 !important
    margin: 0 !important

    & > div:first-child,
    & > #portfolio-showcase
      width: 100% !important
      max-width: 100% !important
      padding: 0 !important
      margin: 0 !important
      background: transparent !important
      box-shadow: none !important
      border-radius: 0 !important

#portfolio-showcase
  width: 100% !important
  max-width: 100% !important
  margin: 0 !important
  padding: 0 !important
  background: transparent !important
  box-shadow: none !important
  border-radius: 0 !important

.portfolio-section
  width: 100% !important
  min-height: 85vh
  display: flex
  align-items: center
  justify-content: center
  padding: 100px 0
  position: relative
  box-sizing: border-box

  // Section 1: Deep Tech Sapphire / Slate Gradient with ambient blue glow
  &.section-theme-0
    background: radial-gradient(circle at 82% 25%, rgba(14, 165, 233, 0.18) 0%, transparent 45%), linear-gradient(135deg, #1e293b 0%, #0f172a 50%, #080d16 100%) !important
    color: #ffffff !important

    .portfolio-tag
      background: rgba(56, 189, 248, 0.18) !important
      color: #38bdf8 !important
      border: 1px solid rgba(56, 189, 248, 0.35) !important

    .portfolio-title
      color: #ffffff !important

    .portfolio-subtitle
      color: rgba(226, 232, 240, 0.8) !important

    .portfolio-desc
      color: rgba(241, 245, 249, 0.92) !important

    .portfolio-highlights li
      color: rgba(226, 232, 240, 0.9) !important

    .portfolio-btn
      border: 1.5px solid rgba(255, 255, 255, 0.3) !important
      color: #ffffff !important
      background: rgba(255, 255, 255, 0.08) !important
      backdrop-filter: blur(8px)

      &:hover
        background: #ffffff !important
        color: #0f172a !important
        border-color: #ffffff !important
        box-shadow: 0 8px 24px rgba(56, 189, 248, 0.3) !important

  // Section 2: Deep Obsidian & Amethyst Gradient with ambient purple glow
  &.section-theme-1
    background: radial-gradient(circle at 18% 75%, rgba(168, 85, 247, 0.18) 0%, transparent 45%), linear-gradient(135deg, #181528 0%, #0f0d1a 50%, #07050d 100%) !important
    color: #ffffff !important

    .portfolio-tag
      background: rgba(192, 132, 252, 0.18) !important
      color: #c084fc !important
      border: 1px solid rgba(192, 132, 252, 0.35) !important

    .portfolio-title
      color: #ffffff !important

    .portfolio-subtitle
      color: rgba(244, 244, 245, 0.8) !important

    .portfolio-desc
      color: rgba(244, 244, 245, 0.92) !important

    .portfolio-highlights li
      color: rgba(228, 228, 231, 0.9) !important

    .portfolio-btn
      border: 1.5px solid rgba(255, 255, 255, 0.3) !important
      color: #ffffff !important
      background: rgba(255, 255, 255, 0.08) !important
      backdrop-filter: blur(8px)

      &:hover
        background: #ffffff !important
        color: #0f0d1a !important
        border-color: #ffffff !important
        box-shadow: 0 8px 24px rgba(168, 85, 247, 0.3) !important

.portfolio-container
  width: 90% !important
  max-width: 1400px !important
  margin: 0 auto !important
  display: flex !important
  align-items: center !important
  justify-content: space-between !important
  gap: 80px !important

.portfolio-container.portfolio-reverse
  flex-direction: row-reverse !important

.portfolio-content
  flex: 1.2
  min-width: 0

.portfolio-tag
  display: inline-block
  font-size: 13px
  font-weight: 600
  padding: 5px 16px
  border-radius: 20px
  margin-bottom: 18px
  letter-spacing: 0.5px

.portfolio-title
  font-size: 38px
  font-weight: 700
  line-height: 1.3
  margin: 0 0 16px 0
  border-bottom: none

.portfolio-subtitle
  font-size: 16px
  font-weight: 500
  margin-bottom: 24px

.portfolio-desc
  font-size: 16px
  line-height: 1.75
  margin-bottom: 20px

.portfolio-highlights
  margin: 0 0 32px 0
  padding-left: 20px
  list-style-type: disc

  li
    font-size: 15px
    line-height: 1.85
    margin-bottom: 8px

.portfolio-actions
  margin-top: 28px

.portfolio-btn
  display: inline-block
  padding: 10px 44px
  font-size: 15px
  font-weight: 600
  border-radius: 30px
  border: 1.5px solid
  text-decoration: none
  transition: all 0.3s ease
  cursor: pointer

  &:hover
    transform: translateY(-2px)

.portfolio-visual
  flex: 1
  display: flex
  justify-content: center
  align-items: center

.portfolio-img-box
  width: 100%
  max-width: 520px
  border-radius: 20px
  overflow: hidden
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45)
  transition: transform 0.4s ease, box-shadow 0.4s ease

  &:hover
    transform: translateY(-8px) scale(1.015)
    box-shadow: 0 32px 75px rgba(0, 0, 0, 0.6)

.portfolio-img
  width: 100%
  height: auto
  display: block

.portfolio-footer-section
  width: 100% !important
  background: linear-gradient(180deg, #07050d 0%, #030406 100%) !important
  padding: 90px 20px
  text-align: center
  box-sizing: border-box
  border-top: 1px solid rgba(255, 255, 255, 0.06)

.portfolio-footer-container
  max-width: 700px
  margin: 0 auto

.footer-banner-title
  font-size: 26px
  font-weight: 700
  color: #ffffff !important
  margin-bottom: 10px

.footer-banner-desc
  font-size: 15px
  color: rgba(255, 255, 255, 0.75) !important
  margin-bottom: 28px

.footer-banner-btn
  display: inline-block
  padding: 12px 38px
  font-size: 15px
  font-weight: 600
  border-radius: 30px
  background: $theme-color
  color: #ffffff !important
  text-decoration: none
  transition: all 0.3s ease

  &:hover
    transform: translateY(-3px)
    box-shadow: 0 10px 25px rgba(73, 177, 245, 0.45)

@media screen and (max-width: 1024px)
  .portfolio-section
    min-height: auto
    padding: 60px 0

  .portfolio-container
    width: 92% !important
    flex-direction: column-reverse !important
    gap: 40px !important

  .portfolio-title
    font-size: 28px

  .portfolio-img-box
    max-width: 100%
