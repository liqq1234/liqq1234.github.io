#body-wrap.type-portfolio
  #content-inner.layout
    max-width: 100% !important
    width: 100% !important
    padding: 0 !important
    margin: 0 !important

    & > div:first-child
      width: 100% !important
      padding: 0 !important
      box-shadow: none !important
      background: transparent !important

.portfolio-showcase
  width: 100%
  margin: 0
  padding: 0

.portfolio-section
  width: 100%
  min-height: 85vh
  display: flex
  align-items: center
  justify-content: center
  padding: 90px 0
  position: relative
  box-sizing: border-box

  &.section-theme-0
    background-color: #928b80
    color: #ffffff

    .portfolio-tag
      background: rgba(255, 255, 255, 0.18)
      color: #ffffff
      border: 1px solid rgba(255, 255, 255, 0.3)

    .portfolio-title
      color: #ffffff

    .portfolio-subtitle
      color: rgba(255, 255, 255, 0.85)

    .portfolio-desc
      color: rgba(255, 255, 255, 0.92)

    .portfolio-highlights li
      color: rgba(255, 255, 255, 0.92)

    .portfolio-btn
      border-color: rgba(255, 255, 255, 0.85)
      color: #ffffff !important
      background: rgba(255, 255, 255, 0.12)

      &:hover
        background: #ffffff
        color: #2c2926 !important
        border-color: #ffffff

  &.section-theme-1
    background-color: #242933
    color: #ffffff

    .portfolio-tag
      background: rgba(192, 132, 252, 0.18)
      color: #c084fc
      border: 1px solid rgba(192, 132, 252, 0.35)

    .portfolio-title
      color: #ffffff

    .portfolio-subtitle
      color: rgba(255, 255, 255, 0.8)

    .portfolio-desc
      color: rgba(255, 255, 255, 0.9)

    .portfolio-highlights li
      color: rgba(255, 255, 255, 0.92)

    .portfolio-btn
      border-color: rgba(255, 255, 255, 0.8)
      color: #ffffff !important
      background: rgba(255, 255, 255, 0.1)

      &:hover
        background: #ffffff
        color: #1a1e24 !important
        border-color: #ffffff

.portfolio-container
  width: 90%
  max-width: 1400px
  margin: 0 auto
  display: flex
  align-items: center
  justify-content: space-between
  gap: 70px

.portfolio-container.portfolio-reverse
  flex-direction: row-reverse

.portfolio-content
  flex: 1.2
  min-width: 0

.portfolio-tag
  display: inline-block
  font-size: 13px
  font-weight: 600
  padding: 5px 16px
  border-radius: 20px
  margin-bottom: 18px
  letter-spacing: 0.5px

.portfolio-title
  font-size: 38px
  font-weight: 700
  line-height: 1.3
  margin: 0 0 16px 0
  border-bottom: none

.portfolio-subtitle
  font-size: 16px
  font-weight: 500
  margin-bottom: 24px

.portfolio-desc
  font-size: 16px
  line-height: 1.75
  margin-bottom: 20px

.portfolio-highlights
  margin: 0 0 32px 0
  padding-left: 20px
  list-style-type: disc

  li
    font-size: 15px
    line-height: 1.85
    margin-bottom: 8px

.portfolio-actions
  margin-top: 28px

.portfolio-btn
  display: inline-block
  padding: 10px 44px
  font-size: 15px
  font-weight: 600
  border-radius: 30px
  border: 1.5px solid
  text-decoration: none
  transition: all 0.3s ease
  cursor: pointer

  &:hover
    transform: translateY(-2px)
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25)

.portfolio-visual
  flex: 1
  display: flex
  justify-content: center
  align-items: center

.portfolio-img-box
  width: 100%
  max-width: 520px
  border-radius: 20px
  overflow: hidden
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35)
  transition: transform 0.4s ease, box-shadow 0.4s ease

  &:hover
    transform: translateY(-8px) scale(1.015)
    box-shadow: 0 32px 75px rgba(0, 0, 0, 0.45)

.portfolio-img
  width: 100%
  height: auto
  display: block

.portfolio-footer-section
  width: 100%
  background: var(--card-bg)
  padding: 80px 20px
  text-align: center

.portfolio-footer-container
  max-width: 700px
  margin: 0 auto

.footer-banner-title
  font-size: 26px
  font-weight: 700
  color: var(--font-color)
  margin-bottom: 10px

.footer-banner-desc
  font-size: 15px
  color: var(--font-color)
  opacity: 0.75
  margin-bottom: 26px

.footer-banner-btn
  display: inline-block
  padding: 12px 36px
  font-size: 15px
  font-weight: 600
  border-radius: 30px
  background: $theme-color
  color: #ffffff !important
  text-decoration: none
  transition: all 0.3s ease

  &:hover
    transform: translateY(-3px)
    box-shadow: 0 10px 25px rgba(73, 177, 245, 0.4)

@media screen and (max-width: 1024px)
  .portfolio-section
    min-height: auto
    padding: 60px 0

  .portfolio-container
    width: 92%
    flex-direction: column-reverse !important
    gap: 40px

  .portfolio-title
    font-size: 28px

  .portfolio-img-box
    max-width: 100%
